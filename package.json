    "graphql": "^16.8.1",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-scripts": "5.0.1",
    "viem": "^2.9.3"
  },
  "scripts": {
    "build": "npm run clean && tsc -p ./tsconfig.prod.json",
    "clean": "rm -rf dist cache",
    "codegen": "yarn codegen:gql; yarn codegen:artifacts; yarn codegen:abi",
    "codegen:abi": "node scripts/generate-viem-abis.js",
    "codegen:artifacts": "hardhat compile",
    "codegen:gql": "node scripts/should-update-gql && graphql-codegen && node ./scripts/gql-type-cleanup.js && eslint src/gql/ --ext=ts --fix",
    "lint": "eslint src/ test/ --ext=ts",
    "lint:fix": "eslint src/ test/ --ext=ts --fix",
    "prepublishOnly": "yarn build",
    "test": "react-scripts test",
    "mocha": "NODE_OPTIONS='--max-old-space-size=2048' mocha",
    "test:access-preview": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/access/**/*.spec.ts\"",
    "test:abi": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/abi/**/*.spec.ts\"",
    "test:client": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/client/**/*.spec.ts\"",
    "test:market-model": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/market/**/*.spec.ts\"",
    "test:read-routing": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/read/**/*.spec.ts\"",
    "test:smoke": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/smoke/**/*.spec.ts\"",
    "test:transactions": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/transactions/**/*.spec.ts\"",
    "test:utils": "NODE_OPTIONS='--max-old-space-size=2048' mocha --no-config --timeout 0 --require ts-node/register \"./test/utils/**/*.spec.ts\""
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
